<?xml version="1.0" encoding="utf-8"?>
<!--
    El diálogo de cambio de modo, con el estilo del de Finalizar: scrim y una
    tarjeta de 440 dp. Lo usan el kiosco y el Panel Local; el título, el
    cuerpo y la acción los pone quien lo muestra.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/scrim"
    android:clickable="true"
    android:focusable="true">

    <LinearLayout
        android:id="@+id/modeCard"
        android:layout_width="440dp"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:background="@drawable/panel_dialog"
        android:clickable="true"
        android:focusable="true"
        android:orientation="vertical"
        android:padding="28dp">

        <TextView
            android:id="@+id/modeTitle"
            style="@style/Panel.Text"
            android:fontFamily="@font/barlow_semibold"
            android:textSize="22sp"
            tools:text="@string/mode_to_local_title" />

        <TextView
            android:id="@+id/modeBody"
            style="@style/Panel.Text"
            android:layout_width="match_parent"
            android:layout_marginTop="12dp"
            android:lineSpacingMultiplier="1.45"
            android:textColor="@color/body"
            tools:text="@string/mode_to_local_body" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:gravity="end"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/modeCancel"
                style="@style/Panel.Button.Outline"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:text="@string/mode_cancel" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/modeConfirm"
                style="@style/Status.DialogAction"
                android:layout_width="wrap_content"
                android:layout_marginStart="10dp"
                tools:text="@string/mode_to_local_action" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
