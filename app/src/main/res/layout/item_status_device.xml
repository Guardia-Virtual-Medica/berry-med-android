<?xml version="1.0" encoding="utf-8"?>
<!--
    Una fila de Dispositivos: 44 dp, punto de 8 dp, nombre y estado a la
    derecha. El margen de −10 dp con 10 dp de relleno deja que el fondo de la
    fila en rojo llegue más allá del texto sin cortarse.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="44dp"
    android:layout_marginStart="-10dp"
    android:layout_marginTop="4dp"
    android:layout_marginEnd="-10dp"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="10dp"
    android:paddingEnd="10dp">

    <View
        android:id="@+id/deviceDot"
        android:layout_width="8dp"
        android:layout_height="8dp"
        android:background="@drawable/panel_dot" />

    <TextView
        android:id="@+id/deviceName"
        style="@style/Panel.Text"
        android:layout_width="0dp"
        android:layout_marginStart="12dp"
        android:layout_weight="1"
        android:maxLines="1"
        android:textColor="@color/text2"
        android:textSize="15sp"
        tools:text="Otoscopio" />

    <TextView
        android:id="@+id/deviceStatus"
        style="@style/Panel.Text"
        android:layout_marginStart="12dp"
        android:maxLines="1"
        android:textColor="@color/muted"
        android:textSize="13sp"
        tools:text="Conectado" />
</LinearLayout>
