<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/monitor"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="18dp"
        android:paddingTop="28dp"
        android:paddingEnd="18dp"
        android:paddingBottom="32dp">

        <!-- El tema no tiene barra de acción: sin este botón sólo se sale con el gesto de atrás. -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/backButton"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="16dp"
                android:text="@string/testing_back"
                android:textColor="@color/vital_on"
                app:strokeColor="@color/vital_dim" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/testing_title"
                android:textColor="@color/vital_on"
                android:textSize="32sp" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:lineSpacingExtra="3dp"
            android:paddingStart="6dp"
            android:text="@string/testing_help"
            android:textColor="@color/vital_dim"
            android:textSize="14sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="6dp">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/startButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:text="@string/testing_start" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/stopButton"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:text="@string/testing_stop"
                android:textColor="@color/vital_on"
                app:strokeColor="@color/vital_dim" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/allButton"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="12dp"
                android:text="@string/testing_all"
                android:textColor="@color/vital_on"
                app:strokeColor="@color/vital_dim" />

            <TextView
                android:id="@+id/testStatus"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textColor="@color/vital_on"
                android:textSize="15sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/testMessage"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="6dp"
            android:textColor="@color/test_fail"
            android:textSize="14sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="6dp">

            <View
                android:id="@+id/berryDot"
                android:layout_width="10dp"
                android:layout_height="10dp"
                android:layout_marginEnd="8dp"
                android:background="@drawable/status_dot" />

            <TextView
                android:id="@+id/berryLine"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/vital_on"
                android:textSize="15sp" />
        </LinearLayout>

        <GridLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:columnCount="3">

            <include
                android:id="@+id/ecgCard"
                layout="@layout/item_test_card"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_columnWeight="1"
                android:layout_margin="6dp" />

            <include
                android:id="@+id/spo2Card"
                layout="@layout/item_test_card"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_columnWeight="1"
                android:layout_margin="6dp" />

            <include
                android:id="@+id/respCard"
                layout="@layout/item_test_card"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_columnWeight="1"
                android:layout_margin="6dp" />

            <include
                android:id="@+id/tempCard"
                layout="@layout/item_test_card"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_columnWeight="1"
                android:layout_margin="6dp" />

            <include
                android:id="@+id/nibpCard"
                layout="@layout/item_test_card"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_columnWeight="1"
                android:layout_margin="6dp" />

            <include
                android:id="@+id/thermoCard"
                layout="@layout/item_test_card"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_columnWeight="1"
                android:layout_margin="6dp" />
        </GridLayout>

        <!-- El hub YKUSH3: un equipo por puerto, se encienden y apagan a mano. -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="6dp"
            android:background="@color/line"
            android:orientation="vertical"
            android:padding="14dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/testing_ykush"
                    android:textColor="@color/vital_on"
                    android:textSize="17sp" />

                <View
                    android:id="@+id/ykushDot"
                    android:layout_width="10dp"
                    android:layout_height="10dp"
                    android:layout_marginEnd="8dp"
                    android:background="@drawable/status_dot"
                    android:backgroundTint="@color/vital_dim" />

                <TextView
                    android:id="@+id/ykushStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="12dp"
                    android:fontFamily="monospace"
                    android:textColor="@color/vital_dim"
                    android:textSize="13sp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/ykushReadButton"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/testing_ykush_read"
                    android:textColor="@color/vital_on"
                    app:strokeColor="@color/vital_dim" />
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/testing_ykush_help"
                android:textColor="@color/vital_dim"
                android:textSize="13sp" />

            <include
                android:id="@+id/ykushPort1"
                layout="@layout/item_ykush_port" />

            <include
                android:id="@+id/ykushPort2"
                layout="@layout/item_ykush_port" />

            <include
                android:id="@+id/ykushPort3"
                layout="@layout/item_ykush_port" />

            <TextView
                android:id="@+id/ykushMessage"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:minHeight="20dp"
                android:textColor="@color/vital_dim"
                android:textSize="14sp" />
        </LinearLayout>

        <!-- Lo que Android ve enchufado: para validar el armado antes del Panel Local. -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="6dp"
            android:background="@color/line"
            android:orientation="vertical"
            android:padding="14dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/testing_devices"
                android:textColor="@color/vital_on"
                android:textSize="17sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/testing_devices_help"
                android:textColor="@color/vital_dim"
                android:textSize="13sp" />

            <TextView
                style="@style/TestingListTitle"
                android:text="@string/testing_usb" />

            <TextView
                android:id="@+id/usbList"
                style="@style/TestingList" />

            <TextView
                style="@style/TestingListTitle"
                android:text="@string/testing_audio" />

            <TextView
                android:id="@+id/audioList"
                style="@style/TestingList" />

            <TextView
                style="@style/TestingListTitle"
                android:text="@string/testing_cameras" />

            <TextView
                android:id="@+id/cameraList"
                style="@style/TestingList" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="6dp"
            android:background="@color/line"
            android:orientation="vertical"
            android:padding="14dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/testing_preview"
                    android:textColor="@color/vital_on"
                    android:textSize="17sp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/copyButton"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/testing_copy"
                    android:textColor="@color/vital_on"
                    app:strokeColor="@color/vital_dim" />
            </LinearLayout>

            <TextView
                android:id="@+id/previewUrl"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:fontFamily="monospace"
                android:textColor="@color/vital_dim"
                android:textIsSelectable="true"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/previewBody"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:fontFamily="monospace"
                android:maxLines="6"
                android:textColor="@color/vital_dim"
                android:textSize="12sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="6dp"
            android:background="@color/line"
            android:orientation="vertical"
            android:padding="14dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/testing_console"
                    android:textColor="@color/vital_on"
                    android:textSize="17sp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/pauseButton"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="8dp"
                    android:text="@string/testing_pause"
                    android:textColor="@color/vital_on"
                    app:strokeColor="@color/vital_dim" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/clearButton"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/testing_clear"
                    android:textColor="@color/vital_on"
                    app:strokeColor="@color/vital_dim" />
            </LinearLayout>

            <TextView
                android:id="@+id/consoleText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:fontFamily="monospace"
                android:lineSpacingExtra="2dp"
                android:minHeight="120dp"
                android:textColor="@color/vital_dim"
                android:textIsSelectable="true"
                android:textSize="12sp" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
