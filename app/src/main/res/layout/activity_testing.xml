<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="18dp"
        android:paddingTop="28dp"
        android:paddingEnd="18dp"
        android:paddingBottom="32dp">

        <!-- El tema no tiene barra de acción: sin este botón sólo se sale con el gesto de atrás. -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/backButton"
                style="@style/Panel.Button.Secondary"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_marginEnd="14dp"
                android:contentDescription="@string/testing_back"
                android:paddingStart="0dp"
                android:paddingEnd="0dp"
                app:icon="@drawable/ic_arrow_back"
                app:iconGravity="textStart"
                app:iconPadding="0dp"
                app:iconSize="22dp" />

            <TextView
                style="@style/Panel.Text.Title"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:text="@string/testing_title"
                android:textSize="22sp" />
        </LinearLayout>

        <TextView
            android:fontFamily="@font/barlow_medium"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:lineSpacingExtra="3dp"
            android:paddingStart="6dp"
            android:text="@string/testing_help"
            android:textColor="@color/body"
            android:textSize="14sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="6dp">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/startButton"
                style="@style/Panel.Button.Form"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:layout_marginEnd="8dp"
                android:text="@string/testing_start" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/stopButton"
                style="@style/Panel.Button.Secondary"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:layout_marginEnd="8dp"
                android:text="@string/testing_stop" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/allButton"
                style="@style/Panel.Button.Secondary"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:layout_marginEnd="12dp"
                android:text="@string/testing_all" />

            <TextView
                android:id="@+id/testStatus"
                style="@style/Panel.Text.Status"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textColor="@color/muted"
                android:textSize="15sp" />
        </LinearLayout>

        <TextView
            android:fontFamily="@font/barlow_medium"
            android:id="@+id/testMessage"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="6dp"
            android:textColor="@color/test_fail"
            android:textSize="14sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="6dp">

            <View
                android:id="@+id/berryDot"
                android:layout_width="8dp"
                android:layout_height="8dp"
                android:layout_marginEnd="8dp"
                android:background="@drawable/panel_dot" />

            <TextView
                android:fontFamily="@font/barlow_medium"
                android:id="@+id/berryLine"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/text"
                android:textSize="15sp" />
        </LinearLayout>

        <GridLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:columnCount="3">

            <include
                android:id="@+id/ecgCard"
                layout="@layout/item_test_card"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_columnWeight="1"
                android:layout_margin="6dp" />

            <include
                android:id="@+id/spo2Card"
                layout="@layout/item_test_card"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_columnWeight="1"
                android:layout_margin="6dp" />

            <include
                android:id="@+id/respCard"
                layout="@layout/item_test_card"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_columnWeight="1"
                android:layout_margin="6dp" />

            <include
                android:id="@+id/tempCard"
                layout="@layout/item_test_card"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_columnWeight="1"
                android:layout_margin="6dp" />

            <include
                android:id="@+id/nibpCard"
                layout="@layout/item_test_card"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_columnWeight="1"
                android:layout_margin="6dp" />

            <include
                android:id="@+id/thermoCard"
                layout="@layout/item_test_card"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_columnWeight="1"
                android:layout_margin="6dp" />
        </GridLayout>

        <!-- El hub YKUSH3: un equipo por puerto, se encienden y apagan a mano. -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="6dp"
            android:background="@drawable/panel_card"
            android:orientation="vertical"
            android:padding="14dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    style="@style/Panel.CardLabel"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/testing_ykush" />

                <View
                    android:id="@+id/ykushDot"
                    android:layout_width="8dp"
                    android:layout_height="8dp"
                    android:layout_marginEnd="8dp"
                    android:background="@drawable/panel_dot" />

                <TextView
                    android:id="@+id/ykushStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="12dp"
                    android:fontFamily="monospace"
                    android:textColor="@color/muted"
                    android:textSize="13sp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/ykushReadButton"
                    style="@style/Panel.Button.Secondary"
                    android:layout_width="wrap_content"
                    android:layout_height="48dp"
                    android:text="@string/testing_ykush_read" />
            </LinearLayout>

            <TextView
                android:fontFamily="@font/barlow_medium"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/testing_ykush_help"
                android:textColor="@color/body"
                android:textSize="13sp" />

            <include
                android:id="@+id/ykushPort1"
                layout="@layout/item_ykush_port" />

            <include
                android:id="@+id/ykushPort2"
                layout="@layout/item_ykush_port" />

            <include
                android:id="@+id/ykushPort3"
                layout="@layout/item_ykush_port" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/ykushSaveBootButton"
                style="@style/Panel.Button.Secondary"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:layout_marginTop="8dp"
                android:text="@string/testing_ykush_save_boot" />

            <TextView
                android:fontFamily="@font/barlow_medium"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/testing_ykush_save_boot_help"
                android:textColor="@color/body"
                android:textSize="13sp" />

            <TextView
                android:fontFamily="@font/barlow_medium"
                android:id="@+id/ykushMessage"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:minHeight="20dp"
                android:textColor="@color/body"
                android:textSize="14sp" />
        </LinearLayout>

        <!-- Lo que Android ve enchufado: para validar el armado antes del Panel Local. -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="6dp"
            android:background="@drawable/panel_card"
            android:orientation="vertical"
            android:padding="14dp">

            <TextView
                style="@style/Panel.CardLabel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/testing_devices" />

            <TextView
                android:fontFamily="@font/barlow_medium"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/testing_devices_help"
                android:textColor="@color/body"
                android:textSize="13sp" />

            <TextView
                style="@style/TestingListTitle"
                android:text="@string/testing_usb" />

            <TextView
                android:id="@+id/usbList"
                style="@style/TestingList" />

            <TextView
                style="@style/TestingListTitle"
                android:text="@string/testing_audio" />

            <TextView
                android:id="@+id/audioList"
                style="@style/TestingList" />

            <TextView
                style="@style/TestingListTitle"
                android:text="@string/testing_cameras" />

            <TextView
                android:id="@+id/cameraList"
                style="@style/TestingList" />
        </LinearLayout>

        <!-- La teleconsulta: lo que Berry Med publica en LiveKit, y una prueba a mano con servidor y token propios. -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="6dp"
            android:background="@drawable/panel_card"
            android:orientation="vertical"
            android:padding="14dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    style="@style/Panel.CardLabel"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/testing_tele" />

                <View
                    android:id="@+id/teleDot"
                    android:layout_width="8dp"
                    android:layout_height="8dp"
                    android:layout_marginEnd="8dp"
                    android:background="@drawable/panel_dot" />

                <TextView
                    android:id="@+id/teleState"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="monospace"
                    android:textColor="@color/muted"
                    android:textSize="13sp" />
            </LinearLayout>

            <TextView
                android:fontFamily="@font/barlow_medium"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/testing_tele_help"
                android:textColor="@color/body"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/teleDetail"
                style="@style/TestingList" />

            <TextView
                style="@style/TestingListTitle"
                android:text="@string/testing_tele_manual" />

            <com.google.android.material.textfield.TextInputLayout
                style="@style/Field"
                android:hint="@string/testing_tele_server"
                android:theme="@style/ThemeOverlay.BerryMed.FormDark">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/teleServer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="monospace"
                    android:inputType="textUri"
                    android:textSize="13sp" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                style="@style/Field"
                android:hint="@string/testing_tele_token"
                android:theme="@style/ThemeOverlay.BerryMed.FormDark">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/teleToken"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="monospace"
                    android:inputType="textNoSuggestions"
                    android:maxLines="3"
                    android:textSize="13sp" />
            </com.google.android.material.textfield.TextInputLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/teleOtoscopeButton"
                    style="@style/Panel.Button.Form"
                    android:layout_width="wrap_content"
                    android:layout_height="48dp"
                    android:layout_marginEnd="8dp"
                    android:text="@string/testing_tele_otoscope" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/teleStethoButton"
                    style="@style/Panel.Button.Form"
                    android:layout_width="wrap_content"
                    android:layout_height="48dp"
                    android:layout_marginEnd="8dp"
                    android:text="@string/testing_tele_stetho" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/teleStopButton"
                    style="@style/Panel.Button.Secondary"
                    android:layout_width="wrap_content"
                    android:layout_height="48dp"
                    android:text="@string/testing_tele_stop" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="6dp"
            android:background="@drawable/panel_card"
            android:orientation="vertical"
            android:padding="14dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    style="@style/Panel.CardLabel"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/testing_preview" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/copyButton"
                    style="@style/Panel.Button.Secondary"
                    android:layout_width="wrap_content"
                    android:layout_height="48dp"
                    android:text="@string/testing_copy" />
            </LinearLayout>

            <TextView
                android:id="@+id/previewUrl"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:fontFamily="monospace"
                android:textColor="@color/muted"
                android:textIsSelectable="true"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/previewBody"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:fontFamily="monospace"
                android:maxLines="6"
                android:textColor="@color/muted"
                android:textSize="13sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="6dp"
            android:background="@drawable/panel_card"
            android:orientation="vertical"
            android:padding="14dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    style="@style/Panel.CardLabel"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/testing_console" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/pauseButton"
                    style="@style/Panel.Button.Secondary"
                    android:layout_width="wrap_content"
                    android:layout_height="48dp"
                    android:layout_marginEnd="8dp"
                    android:text="@string/testing_pause" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/clearButton"
                    style="@style/Panel.Button.Secondary"
                    android:layout_width="wrap_content"
                    android:layout_height="48dp"
                    android:text="@string/testing_clear" />
            </LinearLayout>

            <TextView
                android:id="@+id/consoleText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:fontFamily="monospace"
                android:lineSpacingExtra="2dp"
                android:minHeight="120dp"
                android:textColor="@color/muted"
                android:textIsSelectable="true"
                android:textSize="13sp" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
