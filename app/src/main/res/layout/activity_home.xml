<?xml version="1.0" encoding="utf-8"?>
<!--
    Inicio: el distribuidor de la tablet. Tres cards grandes, ONDOCTOR365,
    Panel Local y Configuración, con los colores de sus íconos. Es la
    pantalla de inicio de Android (HOME) y adonde vuelve todo. La
    Configuración pide el PIN en la capa de abajo. A la derecha, el panel
    lateral de estado, como en el kiosco y el Panel Local.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/homeRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:orientation="horizontal">

    <!-- Las cards y el PIN: todo lo de la izquierda del panel lateral. -->
    <FrameLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1">

    <LinearLayout
        android:id="@+id/content"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingStart="48dp"
        android:paddingTop="40dp"
        android:paddingEnd="48dp"
        android:paddingBottom="40dp">

        <!-- La cabecera: el título y, a la derecha, el idioma de la app. -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:baselineAligned="false"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    style="@style/Panel.Text"
                    android:fontFamily="@font/barlow_semibold"
                    android:text="@string/home_title"
                    android:textSize="34sp" />

                <TextView
                    style="@style/Panel.Text"
                    android:layout_marginTop="10dp"
                    android:text="@string/home_subtitle"
                    android:textColor="@color/body"
                    android:textSize="19sp" />
            </LinearLayout>

            <!-- El idioma: cuadrado, se toca. Con una consulta en curso, deshabilitado y con el motivo abajo. -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="24dp"
                android:gravity="end"
                android:orientation="vertical">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/languageButton"
                    style="@style/Panel.Button"
                    android:layout_width="wrap_content"
                    android:layout_height="48dp"
                    app:icon="@drawable/ic_language" />

                <LinearLayout
                    android:id="@+id/languageBlocked"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="horizontal"
                    android:visibility="gone">

                    <ImageView
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:layout_marginTop="1dp"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_info"
                        app:tint="@color/muted" />

                    <TextView
                        android:id="@+id/languageBlockedText"
                        style="@style/Panel.Text"
                        android:layout_width="wrap_content"
                        android:layout_marginStart="8dp"
                        android:lineSpacingMultiplier="1.2"
                        android:maxWidth="260dp"
                        android:text="@string/language_blocked"
                        android:textColor="@color/muted"
                        android:textSize="13sp" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <Space
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="400dp"
            android:orientation="horizontal">

            <!-- ONDOCTOR365, con el corazón-estetoscopio de su logo sobre el turquesa de la marca. -->
            <LinearLayout
                android:id="@+id/homeOndoctor"
                style="@style/HomeCard">

                <ImageView
                    style="@style/HomeCardIcon"
                    android:backgroundTint="@color/ondoctor_brand"
                    android:padding="8dp"
                    android:src="@drawable/ic_ondoctor_logo"
                    app:tint="@null" />

                <Space
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:layout_weight="1" />

                <TextView
                    style="@style/HomeCardTitle"
                    android:text="@string/ondoctor" />

                <TextView
                    android:id="@+id/homeOndoctorBody"
                    style="@style/HomeCardBody"
                    android:text="@string/home_ondoctor_body" />
            </LinearLayout>

            <!-- Panel Local, en el azul de su ícono. -->
            <LinearLayout
                android:id="@+id/homeLocal"
                style="@style/HomeCard"
                android:layout_marginStart="20dp">

                <ImageView
                    style="@style/HomeCardIcon"
                    android:backgroundTint="@color/local_icon"
                    android:src="@drawable/ic_stethoscope" />

                <Space
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:layout_weight="1" />

                <TextView
                    style="@style/HomeCardTitle"
                    android:text="@string/local_panel" />

                <TextView
                    style="@style/HomeCardBody"
                    android:text="@string/home_local_body" />
            </LinearLayout>

            <!-- Configuración: neutra, es para el técnico. -->
            <LinearLayout
                android:id="@+id/homeConfig"
                style="@style/HomeCard"
                android:layout_marginStart="20dp">

                <ImageView
                    style="@style/HomeCardIcon"
                    android:backgroundTint="@color/surface2"
                    android:src="@drawable/ic_settings" />

                <Space
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:layout_weight="1" />

                <TextView
                    style="@style/HomeCardTitle"
                    android:text="@string/home_config" />

                <TextView
                    style="@style/HomeCardBody"
                    android:text="@string/home_config_body" />
            </LinearLayout>
        </LinearLayout>

        <Space
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1" />
    </LinearLayout>

    <!-- El PIN de la Configuración, con la tarjeta del candado del Panel Local. -->
    <FrameLayout
        android:id="@+id/pinLayer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/scrim"
        android:clickable="true"
        android:focusable="true"
        android:visibility="gone">

        <!-- Más arriba del centro, como el del Panel Local: el teclado no tapa los botones. -->
        <LinearLayout
            android:id="@+id/pinCard"
            android:layout_width="440dp"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:background="@drawable/panel_card"
            android:clickable="true"
            android:focusable="true"
            android:orientation="vertical"
            android:padding="28dp"
            android:translationY="-37dp">

            <TextView
                style="@style/Panel.Text"
                android:fontFamily="@font/barlow_semibold"
                android:text="@string/home_pin_title"
                android:textSize="22sp" />

            <TextView
                style="@style/Panel.Text"
                android:layout_width="match_parent"
                android:layout_marginTop="10dp"
                android:lineSpacingMultiplier="1.25"
                android:text="@string/home_pin_help"
                android:textColor="@color/body"
                android:textSize="15sp" />

            <com.google.android.material.textfield.TextInputLayout
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:hint="@string/local_pin_hint"
                android:textColorHint="@color/muted"
                app:boxBackgroundColor="@color/bg"
                app:boxCornerRadiusBottomEnd="10dp"
                app:boxCornerRadiusBottomStart="10dp"
                app:boxCornerRadiusTopEnd="10dp"
                app:boxCornerRadiusTopStart="10dp"
                app:boxStrokeColor="@color/primary"
                app:hintTextColor="@color/primary">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/pinInput"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/barlow_semi_condensed_semibold"
                    android:gravity="center"
                    android:imeOptions="actionDone"
                    android:inputType="numberPassword"
                    android:maxLength="12"
                    android:singleLine="true"
                    android:textColor="@color/text"
                    android:textSize="24sp" />
            </com.google.android.material.textfield.TextInputLayout>

            <TextView
                android:id="@+id/pinMessage"
                style="@style/Panel.Text"
                android:layout_width="match_parent"
                android:layout_marginTop="8dp"
                android:minHeight="20dp"
                android:textColor="@color/warn"
                android:textSize="15sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="end"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/pinBackButton"
                    style="@style/Panel.Button.Outline"
                    android:layout_width="wrap_content"
                    android:layout_height="48dp"
                    android:text="@string/local_back" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/pinEnterButton"
                    style="@style/Panel.Button.Primary"
                    android:layout_width="wrap_content"
                    android:layout_height="48dp"
                    android:layout_marginStart="10dp"
                    android:paddingStart="24dp"
                    android:paddingEnd="24dp"
                    android:text="@string/local_enter"
                    android:textSize="16sp"
                    app:cornerRadius="10dp" />
            </LinearLayout>
        </LinearLayout>
    </FrameLayout>
    </FrameLayout>

    <!-- El panel lateral de estado, como en el kiosco y el Panel Local: 296 dp abierto, 64 dp en el riel. -->
    <com.guardiavirtual.berrymed.ui.status.StatusPanelView
        android:id="@+id/statusPanel"
        android:layout_width="296dp"
        android:layout_height="match_parent" />
</LinearLayout>
