<?xml version="1.0" encoding="utf-8"?>
<!-- Una miniatura de la lista de capturas: la imagen, el borde y la hora abajo a la izquierda. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="0dp"
    android:layout_height="match_parent"
    android:layout_weight="1"
    android:background="@drawable/panel_thumb"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?android:attr/selectableItemBackground"
    android:visibility="invisible">

    <ImageView
        android:id="@+id/thumbImage"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no"
        android:scaleType="centerCrop" />

    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/panel_thumb_border" />

    <TextView
        android:id="@+id/thumbTime"
        style="@style/Panel.Text"
        android:layout_gravity="bottom|start"
        android:layout_marginStart="8dp"
        android:layout_marginBottom="6dp"
        android:fontFeatureSettings="tnum"
        android:textColor="@color/text2"
        android:textSize="12sp"
        tools:text="10:12:19" />
</FrameLayout>
