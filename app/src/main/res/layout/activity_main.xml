<?xml version="1.0" encoding="utf-8"?>
<!--
    La pantalla principal, con los tokens y estilos del Panel Local: la
    cabecera fija con los chips de estado y la ruedita; abajo, los vitales, el
    estado y los botones. La configuración es una capa que tapa ese contenido
    y se abre con USB-config.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="24dp"
        android:paddingTop="16dp"
        android:paddingEnd="24dp"
        android:paddingBottom="12dp">

        <TextView
            style="@style/Panel.Text.Title"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="@string/screen_title"
            android:textSize="22sp" />

        <TextView
            android:id="@+id/chipBerry"
            style="@style/Panel.Chip"
            android:layout_width="wrap_content"
            android:text="@string/main_chip_berry" />

        <TextView
            android:id="@+id/chipPusher"
            style="@style/Panel.Chip"
            android:layout_width="wrap_content"
            android:text="@string/main_chip_pusher" />

        <TextView
            android:id="@+id/chipThermo"
            style="@style/Panel.Chip"
            android:layout_width="wrap_content"
            android:text="@string/main_chip_thermo" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/settingsButton"
            style="@style/Panel.Button.Secondary"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginStart="12dp"
            android:contentDescription="@string/settings"
            android:paddingStart="0dp"
            android:paddingEnd="0dp"
            app:icon="@drawable/ic_settings"
            app:iconGravity="textStart"
            app:iconPadding="0dp"
            app:iconSize="22dp" />
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <ScrollView
            android:id="@+id/mainContent"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="24dp"
                android:paddingEnd="24dp"
                android:paddingBottom="24dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:baselineAligned="false"
                    android:orientation="horizontal">

            <LinearLayout
                style="@style/Panel.Card"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginEnd="10dp"
                android:layout_weight="1">

                <LinearLayout style="@style/Panel.CardTop">
                    <TextView
                        style="@style/Panel.CardLabel"
                        android:text="FC"
                        android:textColor="@color/ecg" />

                    <View
                        android:layout_width="0dp"
                        android:layout_height="1dp"
                        android:layout_weight="1" />

                    <TextView
                        style="@style/Panel.CardUnit"
                        android:text="lpm" />
                </LinearLayout>

                <TextView
                    android:id="@+id/heartRate"
                    style="@style/Panel.Value"
                    android:layout_marginTop="10dp"
                    android:textColor="@color/faint"
                    android:textSize="44sp" />
            </LinearLayout>

            <LinearLayout
                style="@style/Panel.Card"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginEnd="10dp"
                android:layout_weight="1">

                <LinearLayout style="@style/Panel.CardTop">
                    <TextView
                        style="@style/Panel.CardLabel"
                        android:text="SpO₂"
                        android:textColor="@color/spo2" />

                    <View
                        android:layout_width="0dp"
                        android:layout_height="1dp"
                        android:layout_weight="1" />

                    <TextView
                        style="@style/Panel.CardUnit"
                        android:text="% / lpm" />
                </LinearLayout>

                <TextView
                    android:id="@+id/spo2Pulse"
                    style="@style/Panel.Value"
                    android:layout_marginTop="10dp"
                    android:textColor="@color/faint"
                    android:textSize="34sp" />
            </LinearLayout>

            <LinearLayout
                style="@style/Panel.Card"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginEnd="10dp"
                android:layout_weight="1">

                <LinearLayout style="@style/Panel.CardTop">
                    <TextView
                        style="@style/Panel.CardLabel"
                        android:text="Resp"
                        android:textColor="@color/resp" />

                    <View
                        android:layout_width="0dp"
                        android:layout_height="1dp"
                        android:layout_weight="1" />

                    <TextView
                        style="@style/Panel.CardUnit"
                        android:text="rpm" />
                </LinearLayout>

                <TextView
                    android:id="@+id/respRate"
                    style="@style/Panel.Value"
                    android:layout_marginTop="10dp"
                    android:textColor="@color/faint"
                    android:textSize="44sp" />
            </LinearLayout>

            <LinearLayout
                style="@style/Panel.Card"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginEnd="10dp"
                android:layout_weight="1">

                <LinearLayout style="@style/Panel.CardTop">
                    <TextView
                        style="@style/Panel.CardLabel"
                        android:text="Temp"
                        android:textColor="@color/temp" />

                    <View
                        android:layout_width="0dp"
                        android:layout_height="1dp"
                        android:layout_weight="1" />

                    <TextView
                        style="@style/Panel.CardUnit"
                        android:text="°C" />
                </LinearLayout>

                <TextView
                    android:id="@+id/temperature"
                    style="@style/Panel.Value"
                    android:layout_marginTop="10dp"
                    android:textColor="@color/faint"
                    android:textSize="44sp" />
            </LinearLayout>

            <LinearLayout
                style="@style/Panel.Card"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginEnd="0dp"
                android:layout_weight="1">

                <LinearLayout style="@style/Panel.CardTop">
                    <TextView
                        style="@style/Panel.CardLabel"
                        android:text="PA"
                        android:textColor="@color/pa" />

                    <View
                        android:layout_width="0dp"
                        android:layout_height="1dp"
                        android:layout_weight="1" />

                    <TextView
                        style="@style/Panel.CardUnit"
                        android:text="mmHg" />
                </LinearLayout>

                <TextView
                    android:id="@+id/nibp"
                    style="@style/Panel.Value"
                    android:layout_marginTop="10dp"
                    android:textColor="@color/faint"
                    android:textSize="34sp" />
            </LinearLayout>
                </LinearLayout>

                <LinearLayout
                    style="@style/Panel.Card"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp">

                    <TextView
                        style="@style/Panel.Text.Caps"
                        android:text="@string/main_status" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <View
                            android:id="@+id/berryDot"
                            android:layout_width="8dp"
                            android:layout_height="8dp"
                            android:layout_marginEnd="8dp"
                            android:background="@drawable/panel_dot" />

                        <TextView
                            android:id="@+id/berryStatus"
                            style="@style/MainStatusText"
                            android:layout_marginTop="0dp"
                            android:textColor="@color/text" />
                    </LinearLayout>

                    <TextView android:id="@+id/lastData" style="@style/MainStatusText" />
                    <TextView android:id="@+id/pusherStatus" style="@style/MainStatusText" />
                    <TextView android:id="@+id/otherStatus" style="@style/MainStatusText" />
                    <TextView
                        android:id="@+id/lastPost"
                        style="@style/MainStatusText"
                        android:textColor="@color/muted" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:orientation="horizontal">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/usbButton"
                        style="@style/MainButton"
                        android:layout_marginEnd="10dp"
                        android:text="@string/usb_permission" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/testingButton"
                        style="@style/MainButton"
                        android:layout_marginEnd="10dp"
                        android:text="@string/testing" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/localPanelButton"
                        style="@style/MainButton"
                        android:layout_marginEnd="10dp"
                        android:text="@string/local_panel" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/ondoctorButton"
                        style="@style/MainButton.Primary"
                        android:text="@string/ondoctor" />
                </LinearLayout>

                <TextView
                    style="@style/Panel.Text.Small"
                    android:layout_width="match_parent"
                    android:layout_marginTop="10dp"
                    android:lineSpacingExtra="3dp"
                    android:text="@string/help_ondoctor"
                    android:textColor="@color/body"
                    android:textSize="14sp" />
            </LinearLayout>
        </ScrollView>

        <!-- La configuración: tapa el contenido de abajo de la cabecera. ← y atrás la cierran sin guardar. -->
        <LinearLayout
            android:id="@+id/configLayer"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/bg"
            android:clickable="true"
            android:focusable="true"
            android:orientation="vertical"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="24dp"
                android:paddingEnd="24dp"
                android:paddingBottom="12dp">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/configClose"
                    style="@style/Panel.Button.Secondary"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:contentDescription="@string/config_close"
                    android:paddingStart="0dp"
                    android:paddingEnd="0dp"
                    app:icon="@drawable/ic_arrow_back"
                    app:iconGravity="textStart"
                    app:iconPadding="0dp"
                    app:iconSize="22dp" />

                <TextView
                    style="@style/Panel.Text.Title"
                    android:layout_marginStart="14dp"
                    android:text="@string/config_title" />
            </LinearLayout>

            <ScrollView
                android:id="@+id/configScroll"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:paddingStart="24dp"
                android:paddingEnd="24dp">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingBottom="24dp">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:background="@drawable/panel_card"
                        android:orientation="vertical"
                        android:padding="20dp"
                        android:theme="@style/ThemeOverlay.BerryMed.FormDark"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintWidth_max="760dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal">

                            <TextView
                                android:id="@+id/stepDestination"
                                style="@style/StepLabel"
                                android:text="@string/step_destination"
                                android:textColor="@color/primary" />

                            <TextView
                                android:id="@+id/stepOrders"
                                style="@style/StepLabel"
                                android:text="@string/step_orders"
                                android:textColor="@color/muted" />

                            <TextView
                                android:id="@+id/stepDevice"
                                style="@style/StepLabel"
                                android:text="@string/step_device"
                                android:textColor="@color/muted" />

                            <TextView
                                android:id="@+id/stepKiosk"
                                style="@style/StepLabel"
                                android:text="@string/step_kiosk"
                                android:textColor="@color/muted" />
                        </LinearLayout>

                        <ViewFlipper
                            android:id="@+id/steps"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:measureAllChildren="false">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="vertical">

                                <TextView style="@style/FormTitle" android:layout_marginTop="8dp" android:text="@string/section_destination" />
                                <TextView style="@style/Help" android:text="@string/help_destination" />

                                <TextView
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="16dp"
                                    android:text="@string/label_environment"
                                    android:textColor="@color/text"
                                    android:textSize="15sp" />

                                <com.google.android.material.chip.ChipGroup
                                    android:id="@+id/environment"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    app:selectionRequired="true"
                                    app:singleSelection="true">

                                    <com.google.android.material.chip.Chip style="@style/Widget.Material3.Chip.Filter" android:layout_width="wrap_content" android:layout_height="wrap_content" android:checked="true" android:text="@string/environment_prod" />
                                    <com.google.android.material.chip.Chip style="@style/Widget.Material3.Chip.Filter" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/environment_dev" />
                                </com.google.android.material.chip.ChipGroup>

                                <com.google.android.material.textfield.TextInputLayout style="@style/Field" android:hint="@string/hint_totem">
                                    <com.google.android.material.textfield.TextInputEditText
                                        android:id="@+id/totemId"
                                        android:layout_width="match_parent"
                                        android:layout_height="wrap_content"
                                        android:inputType="text"
                                        android:singleLine="true" />
                                </com.google.android.material.textfield.TextInputLayout>

                                <com.google.android.material.textfield.TextInputLayout
                                    style="@style/Field"
                                    android:hint="@string/hint_api"
                                    app:helperText="@string/help_from_environment">
                                    <com.google.android.material.textfield.TextInputEditText
                                        android:id="@+id/apiUrl"
                                        android:layout_width="match_parent"
                                        android:layout_height="wrap_content"
                                        android:inputType="textUri"
                                        android:singleLine="true" />
                                </com.google.android.material.textfield.TextInputLayout>

                                <TextView
                                    android:id="@+id/urlPreview"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="12dp"
                                    android:text="@string/url_preview_empty"
                                    android:textColor="@color/text"
                                    android:textSize="15sp" />
                            </LinearLayout>

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="vertical">

                                <TextView style="@style/FormTitle" android:layout_marginTop="8dp" android:text="@string/section_orders" />
                                <TextView style="@style/Help" android:text="@string/help_orders" />

                                <com.google.android.material.textfield.TextInputLayout
                                    style="@style/Field"
                                    android:hint="@string/hint_pusher"
                                    app:helperText="@string/help_from_environment">
                                    <com.google.android.material.textfield.TextInputEditText
                                        android:id="@+id/pusherKey"
                                        android:layout_width="match_parent"
                                        android:layout_height="wrap_content"
                                        android:inputType="text"
                                        android:singleLine="true" />
                                </com.google.android.material.textfield.TextInputLayout>

                                <com.google.android.material.textfield.TextInputLayout
                                    style="@style/Widget.Material3.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="8dp"
                                    android:hint="@string/hint_cluster"
                                    app:helperText="@string/help_cluster">
                                    <com.google.android.material.textfield.MaterialAutoCompleteTextView
                                        android:id="@+id/pusherCluster"
                                        android:layout_width="match_parent"
                                        android:layout_height="wrap_content"
                                        android:inputType="none"
                                        app:simpleItems="@array/pusher_clusters" />
                                </com.google.android.material.textfield.TextInputLayout>

                                <com.google.android.material.textfield.TextInputLayout
                                    style="@style/Field"
                                    android:hint="@string/hint_channel"
                                    app:helperText="@string/help_channel">
                                    <com.google.android.material.textfield.TextInputEditText
                                        android:id="@+id/channel"
                                        android:layout_width="match_parent"
                                        android:layout_height="wrap_content"
                                        android:inputType="text"
                                        android:singleLine="true" />
                                </com.google.android.material.textfield.TextInputLayout>

                                <TextView style="@style/Help" android:layout_marginTop="16dp" android:text="@string/help_known_values" />

                                <com.google.android.material.textfield.TextInputLayout style="@style/Field" android:hint="@string/hint_start">
                                    <com.google.android.material.textfield.TextInputEditText
                                        android:id="@+id/startEvent"
                                        android:layout_width="match_parent"
                                        android:layout_height="wrap_content"
                                        android:inputType="text"
                                        android:singleLine="true"
                                        android:text="start-monitoring" />
                                </com.google.android.material.textfield.TextInputLayout>

                                <com.google.android.material.textfield.TextInputLayout style="@style/Field" android:hint="@string/hint_stop">
                                    <com.google.android.material.textfield.TextInputEditText
                                        android:id="@+id/stopEvent"
                                        android:layout_width="match_parent"
                                        android:layout_height="wrap_content"
                                        android:inputType="text"
                                        android:singleLine="true"
                                        android:text="stop-monitoring" />
                                </com.google.android.material.textfield.TextInputLayout>
                            </LinearLayout>

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="vertical">

                                <TextView style="@style/FormTitle" android:layout_marginTop="8dp" android:text="@string/section_device" />
                                <TextView style="@style/Help" android:text="@string/help_device" />
                                <TextView style="@style/Help" android:layout_marginTop="8dp" android:text="@string/help_usb_default" />

                                <TextView
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="16dp"
                                    android:text="@string/label_ecg_gain"
                                    android:textColor="@color/text"
                                    android:textSize="15sp" />

                                <com.google.android.material.chip.ChipGroup
                                    android:id="@+id/ecgGain"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    app:selectionRequired="true"
                                    app:singleSelection="true">

                                    <com.google.android.material.chip.Chip style="@style/Widget.Material3.Chip.Filter" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="x0.25" />
                                    <com.google.android.material.chip.Chip style="@style/Widget.Material3.Chip.Filter" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="x0.5" />
                                    <com.google.android.material.chip.Chip style="@style/Widget.Material3.Chip.Filter" android:layout_width="wrap_content" android:layout_height="wrap_content" android:checked="true" android:text="x1" />
                                    <com.google.android.material.chip.Chip style="@style/Widget.Material3.Chip.Filter" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="x2" />
                                </com.google.android.material.chip.ChipGroup>

                                <TextView
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="12dp"
                                    android:text="@string/label_ecg_mode"
                                    android:textColor="@color/text"
                                    android:textSize="15sp" />

                                <com.google.android.material.chip.ChipGroup
                                    android:id="@+id/ecgMode"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    app:selectionRequired="true"
                                    app:singleSelection="true">

                                    <com.google.android.material.chip.Chip style="@style/Widget.Material3.Chip.Filter" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Operación" />
                                    <com.google.android.material.chip.Chip style="@style/Widget.Material3.Chip.Filter" android:layout_width="wrap_content" android:layout_height="wrap_content" android:checked="true" android:text="Monitor" />
                                    <com.google.android.material.chip.Chip style="@style/Widget.Material3.Chip.Filter" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Diagnóstico" />
                                </com.google.android.material.chip.ChipGroup>

                                <TextView
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="12dp"
                                    android:text="@string/label_resp_gain"
                                    android:textColor="@color/text"
                                    android:textSize="15sp" />

                                <com.google.android.material.chip.ChipGroup
                                    android:id="@+id/respGain"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    app:selectionRequired="true"
                                    app:singleSelection="true">

                                    <com.google.android.material.chip.Chip style="@style/Widget.Material3.Chip.Filter" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="x0.25" />
                                    <com.google.android.material.chip.Chip style="@style/Widget.Material3.Chip.Filter" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="x0.5" />
                                    <com.google.android.material.chip.Chip style="@style/Widget.Material3.Chip.Filter" android:layout_width="wrap_content" android:layout_height="wrap_content" android:checked="true" android:text="x1" />
                                    <com.google.android.material.chip.Chip style="@style/Widget.Material3.Chip.Filter" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="x2" />
                                </com.google.android.material.chip.ChipGroup>

                                <TextView
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="12dp"
                                    android:text="@string/label_nibp_mode"
                                    android:textColor="@color/text"
                                    android:textSize="15sp" />

                                <com.google.android.material.chip.ChipGroup
                                    android:id="@+id/nibpMode"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    app:selectionRequired="true"
                                    app:singleSelection="true">

                                    <com.google.android.material.chip.Chip style="@style/Widget.Material3.Chip.Filter" android:layout_width="wrap_content" android:layout_height="wrap_content" android:checked="true" android:text="Adulto" />
                                    <com.google.android.material.chip.Chip style="@style/Widget.Material3.Chip.Filter" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Niño" />
                                    <com.google.android.material.chip.Chip style="@style/Widget.Material3.Chip.Filter" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Neonato" />
                                </com.google.android.material.chip.ChipGroup>

                                <com.google.android.material.textfield.TextInputLayout
                                    style="@style/Field"
                                    android:hint="@string/hint_nibp_target"
                                    app:helperText="@string/help_nibp_target">
                                    <com.google.android.material.textfield.TextInputEditText
                                        android:id="@+id/nibpTarget"
                                        android:layout_width="match_parent"
                                        android:layout_height="wrap_content"
                                        android:inputType="number"
                                        android:singleLine="true" />
                                </com.google.android.material.textfield.TextInputLayout>

                                <TextView style="@style/FormTitle" android:layout_marginTop="16dp" android:text="@string/section_ykush" />
                                <TextView style="@style/Help" android:text="@string/help_ykush" />

                                <com.google.android.material.textfield.TextInputLayout
                                    style="@style/Field"
                                    android:hint="@string/hint_ykush_otoscope">
                                    <com.google.android.material.textfield.TextInputEditText
                                        android:id="@+id/ykushOtoscope"
                                        android:layout_width="match_parent"
                                        android:layout_height="wrap_content"
                                        android:inputType="number"
                                        android:singleLine="true"
                                        android:text="1" />
                                </com.google.android.material.textfield.TextInputLayout>

                                <com.google.android.material.textfield.TextInputLayout
                                    style="@style/Field"
                                    android:hint="@string/hint_ykush_stethoscope">
                                    <com.google.android.material.textfield.TextInputEditText
                                        android:id="@+id/ykushStethoscope"
                                        android:layout_width="match_parent"
                                        android:layout_height="wrap_content"
                                        android:inputType="number"
                                        android:singleLine="true"
                                        android:text="2" />
                                </com.google.android.material.textfield.TextInputLayout>

                                <com.google.android.material.textfield.TextInputLayout
                                    style="@style/Field"
                                    android:hint="@string/hint_ykush_headset">
                                    <com.google.android.material.textfield.TextInputEditText
                                        android:id="@+id/ykushHeadset"
                                        android:layout_width="match_parent"
                                        android:layout_height="wrap_content"
                                        android:inputType="number"
                                        android:singleLine="true"
                                        android:text="3" />
                                </com.google.android.material.textfield.TextInputLayout>

                                <TextView style="@style/FormTitle" android:layout_marginTop="16dp" android:text="@string/section_stetho" />
                                <TextView style="@style/Help" android:text="@string/help_stetho" />

                                <com.google.android.material.textfield.TextInputLayout
                                    style="@style/Field"
                                    android:hint="@string/hint_stetho_input">
                                    <com.google.android.material.textfield.TextInputEditText
                                        android:id="@+id/stethoInputName"
                                        android:layout_width="match_parent"
                                        android:layout_height="wrap_content"
                                        android:inputType="text"
                                        android:singleLine="true"
                                        android:text="USB Audio" />
                                </com.google.android.material.textfield.TextInputLayout>

                                <com.google.android.material.textfield.TextInputLayout
                                    style="@style/Field"
                                    android:hint="@string/hint_headset_name">
                                    <com.google.android.material.textfield.TextInputEditText
                                        android:id="@+id/headsetName"
                                        android:layout_width="match_parent"
                                        android:layout_height="wrap_content"
                                        android:inputType="text"
                                        android:singleLine="true"
                                        android:text="H390" />
                                </com.google.android.material.textfield.TextInputLayout>

                                <TextView style="@style/FormTitle" android:layout_marginTop="16dp" android:text="@string/section_local" />
                                <TextView style="@style/Help" android:text="@string/help_local" />

                                <com.google.android.material.textfield.TextInputLayout
                                    style="@style/Field"
                                    android:hint="@string/hint_local_pin">
                                    <com.google.android.material.textfield.TextInputEditText
                                        android:id="@+id/localPin"
                                        android:layout_width="match_parent"
                                        android:layout_height="wrap_content"
                                        android:inputType="number"
                                        android:singleLine="true"
                                        android:text="1515" />
                                </com.google.android.material.textfield.TextInputLayout>
                            </LinearLayout>

                            <!--
                                El paso Kiosco: la URL y lo que hace falta para que el kiosco
                                corra dentro de Berry Med. El estado de cada ítem se recalcula
                                al volver a la pantalla y al mostrar el paso.
                            -->
                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="vertical">

                                <TextView style="@style/FormTitle" android:layout_marginTop="8dp" android:text="@string/section_kiosk" />
                                <TextView style="@style/Help" android:text="@string/help_kiosk" />

                                <com.google.android.material.textfield.TextInputLayout
                                    style="@style/Field"
                                    android:hint="@string/hint_kiosk_url"
                                    app:helperText="@string/help_kiosk_url">
                                    <com.google.android.material.textfield.TextInputEditText
                                        android:id="@+id/kioskUrl"
                                        android:layout_width="match_parent"
                                        android:layout_height="wrap_content"
                                        android:inputType="textUri"
                                        android:singleLine="true" />
                                </com.google.android.material.textfield.TextInputLayout>

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="12dp"
                                    android:text="@string/label_call_audio"
                                    android:textColor="@color/text"
                                    android:textSize="15sp" />

                                <com.google.android.material.chip.ChipGroup
                                    android:id="@+id/callAudio"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    app:selectionRequired="true"
                                    app:singleSelection="true">

                                    <com.google.android.material.chip.Chip style="@style/Widget.Material3.Chip.Filter" android:layout_width="wrap_content" android:layout_height="wrap_content" android:checked="true" android:text="@string/call_audio_headset" />
                                    <com.google.android.material.chip.Chip style="@style/Widget.Material3.Chip.Filter" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/call_audio_speaker" />
                                </com.google.android.material.chip.ChipGroup>

                                <TextView style="@style/Help" android:text="@string/help_call_audio" />

                                <TextView style="@style/FormTitle" android:layout_marginTop="16dp" android:text="@string/section_kiosk_checklist" />
                                <TextView style="@style/Help" android:text="@string/help_kiosk_checklist" />

                                <include android:id="@+id/checkPermissions" layout="@layout/item_kiosk_check" />
                                <include android:id="@+id/checkHome" layout="@layout/item_kiosk_check" />
                                <include android:id="@+id/checkService" layout="@layout/item_kiosk_check" />
                                <include android:id="@+id/checkBattery" layout="@layout/item_kiosk_check" />
                                <include android:id="@+id/checkOtoscope" layout="@layout/item_kiosk_check" />
                                <include android:id="@+id/checkTotem" layout="@layout/item_kiosk_check" />

                                <TextView style="@style/FormTitle" android:layout_marginTop="20dp" android:text="@string/section_kiosk_outside" />
                                <TextView style="@style/Help" android:layout_marginTop="6dp" android:text="@string/kiosk_outside_ondoctor" />
                                <TextView style="@style/Help" android:layout_marginTop="6dp" android:text="@string/kiosk_outside_chrome" />
                                <TextView style="@style/Help" android:layout_marginTop="6dp" android:text="@string/kiosk_outside_exit" />
                            </LinearLayout>
                        </ViewFlipper>

                        <TextView
                            android:id="@+id/formMessage"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:textColor="@color/text"
                            android:textSize="15sp" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:orientation="horizontal">

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/backButton"
                                style="@style/Panel.Button.Secondary"
                                android:layout_width="0dp"
                                android:layout_marginEnd="8dp"
                                android:layout_weight="1"
                                android:text="@string/back"
                                android:visibility="gone" />

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/nextButton"
                                style="@style/Panel.Button.Form"
                                android:layout_width="0dp"
                                android:layout_weight="1"
                                android:text="@string/next"
                                />

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/saveButton"
                                style="@style/Panel.Button.Form"
                                android:layout_width="0dp"
                                android:layout_weight="1"
                                android:text="@string/save"
                                android:visibility="gone" />
                        </LinearLayout>
                    </LinearLayout>
                </androidx.constraintlayout.widget.ConstraintLayout>
            </ScrollView>
        </LinearLayout>
    </FrameLayout>
</LinearLayout>
