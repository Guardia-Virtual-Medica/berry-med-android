<?xml version="1.0" encoding="utf-8"?>
<!-- El panel lateral y el riel: fondo statusBg con un borde izquierdo de 2 dp en statusEdge. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/statusEdge" />
        </shape>
    </item>
    <item android:left="2dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/statusBg" />
        </shape>
    </item>
</layer-list>
