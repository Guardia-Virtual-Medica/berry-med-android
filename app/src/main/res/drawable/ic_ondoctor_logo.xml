<?xml version="1.0" encoding="utf-8"?>
<!--
    El corazón-estetoscopio del logo de ONDOCTOR365, redibujado en vector a
    partir del PNG de 29 px: los auriculares arriba, el tubo hace el corazón y
    baja a la campana, abajo a la izquierda. Va en blanco sobre el turquesa
    (ondoctor_brand) de la card de Inicio.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="48dp"
    android:height="48dp"
    android:viewportWidth="28"
    android:viewportHeight="28">

    <!-- El corazón: dos lóbulos que nacen de los auriculares y se juntan en la punta. -->
    <path
        android:pathData="M12.4,6.2 L12.4,5.4 C12.4,4.6 11.7,4.3 10.2,4.3 C7.8,4.3 6.4,5.9 6.4,8.3 C6.4,10.6 8.1,12.7 10.1,14.4 L14.6,17.4 L19.1,14.4 C21.1,12.7 22.8,10.6 22.8,8.3 C22.8,5.9 21.4,4.3 19,4.3 C17.5,4.3 16.8,4.6 16.8,5.4 L16.8,6.2"
        android:strokeWidth="1.7"
        android:strokeColor="#FFFFFFFF"
        android:strokeLineCap="round"
        android:strokeLineJoin="round" />

    <!-- El tubo que baja de la punta y dobla hacia la campana. -->
    <path
        android:pathData="M14.6,17.4 L15.4,20.4 C15.9,22.4 15.1,23.7 13.2,23.7 L8.8,23.7"
        android:strokeWidth="1.7"
        android:strokeColor="#FFFFFFFF"
        android:strokeLineCap="round"
        android:strokeLineJoin="round" />

    <!-- La campana. -->
    <path
        android:pathData="M8.8,21.3 m-2.3,0 a2.3,2.3 0,1 1,4.6 0 a2.3,2.3 0,1 1,-4.6 0"
        android:strokeWidth="1.7"
        android:strokeColor="#FFFFFFFF" />
</vector>
