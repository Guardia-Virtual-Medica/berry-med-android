<?xml version="1.0" encoding="utf-8"?>
<!-- La barra de volumen del panel lateral: 6 dp, pista line y relleno text2. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:id="@android:id/background" android:gravity="center_vertical" android:height="6dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/line" />
            <corners android:radius="3dp" />
        </shape>
    </item>
    <item android:id="@android:id/progress" android:gravity="center_vertical" android:height="6dp">
        <clip>
            <shape android:shape="rectangle">
                <solid android:color="@color/text2" />
                <corners android:radius="3dp" />
            </shape>
        </clip>
    </item>
</layer-list>
