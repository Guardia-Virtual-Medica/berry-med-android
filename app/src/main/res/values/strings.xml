    <string name="check_home_missing">El inicio es otra app. Elegí Berry Med; si pregunta, con «Siempre».</string>
    <string name="check_home_action">Elegir app de inicio</string>
    <string name="check_service">Servicio con cámara y micrófono para la teleconsulta</string>
