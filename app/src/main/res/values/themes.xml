<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Theme.BerryMed" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/signal</item>
        <item name="colorOnPrimary">@color/vital_on</item>
        <item name="android:statusBarColor">@color/monitor</item>
        <item name="android:navigationBarColor">@color/monitor</item>
        <item name="android:windowBackground">@color/monitor</item>
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:forceDarkAllowed" tools:targetApi="q">false</item>
    </style>

    <style name="ThemeOverlay.BerryMed.Form" parent="ThemeOverlay.Material3.Light">
        <item name="colorPrimary">@color/signal</item>
        <item name="colorOnSurface">@color/ink</item>
    </style>

    <style name="VitalLabel">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">@color/vital_dim</item>
        <item name="android:textSize">14sp</item>
    </style>

    <style name="VitalValue">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">@color/vital_on</item>
        <item name="android:textSize">40sp</item>
        <item name="android:fontFamily">sans-serif-light</item>
        <item name="android:includeFontPadding">false</item>
    </style>

    <style name="FormTitle">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">18dp</item>
        <item name="android:textColor">@color/ink</item>
        <item name="android:textSize">18sp</item>
    </style>

    <style name="Field">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">8dp</item>
    </style>

    <style name="Help">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">4dp</item>
        <item name="android:lineSpacingExtra">3dp</item>
        <item name="android:textColor">@color/ink_soft</item>
        <item name="android:textSize">15sp</item>
    </style>

    <!-- Las listas de dispositivos del panel Testing. -->
    <style name="TestingListTitle">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">10dp</item>
        <item name="android:textColor">@color/vital_on</item>
        <item name="android:textSize">14sp</item>
    </style>

    <style name="TestingList">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">2dp</item>
        <item name="android:fontFamily">monospace</item>
        <item name="android:lineSpacingExtra">2dp</item>
        <item name="android:textColor">@color/vital_dim</item>
        <item name="android:textIsSelectable">true</item>
        <item name="android:textSize">12sp</item>
    </style>

    <style name="StepLabel">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:background">?attr/selectableItemBackground</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
        <item name="android:gravity">center</item>
        <item name="android:paddingTop">8dp</item>
        <item name="android:paddingBottom">8dp</item>
        <item name="android:textSize">15sp</item>
    </style>

    <!-- Las tarjetas del Panel Local, del mismo color que las de Testing. -->
    <style name="LocalCard">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginBottom">8dp</item>
        <item name="android:background">@color/line</item>
        <item name="android:orientation">vertical</item>
        <item name="android:padding">10dp</item>
    </style>

    <style name="LocalCardTitle">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">@color/vital_dim</item>
        <item name="android:textSize">14sp</item>
    </style>

    <style name="LocalValueRow">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:baselineAligned">true</item>
        <item name="android:orientation">horizontal</item>
    </style>

    <style name="LocalValue">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginEnd">6dp</item>
        <item name="android:fontFamily">sans-serif-light</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:text">—</item>
        <item name="android:textColor">@color/vital_on</item>
        <item name="android:textSize">40sp</item>
    </style>

    <style name="LocalUnit">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">@color/vital_dim</item>
        <item name="android:textSize">16sp</item>
    </style>

    <style name="LocalDetail">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">2dp</item>
        <item name="android:lineSpacingExtra">2dp</item>
        <item name="android:textColor">@color/vital_dim</item>
        <item name="android:textSize">13sp</item>
    </style>

    <!--
        Los botones de una fila de tarjeta, a partes iguales. Sin el margen
        lateral de Material y con menos relleno: en 1280×800 dp entran tres en
        la columna derecha sin partir el texto en dos líneas.
    -->
    <style name="LocalRowButton" parent="Widget.Material3.Button">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:insetLeft">0dp</item>
        <item name="android:insetRight">0dp</item>
        <item name="android:paddingStart">8dp</item>
        <item name="android:paddingEnd">8dp</item>
        <item name="android:maxLines">1</item>
    </style>

    <style name="LocalRowButton.Outlined" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:insetLeft">0dp</item>
        <item name="android:insetRight">0dp</item>
        <item name="android:paddingStart">8dp</item>
        <item name="android:paddingEnd">8dp</item>
        <item name="android:maxLines">1</item>
        <item name="android:textColor">@color/vital_on</item>
        <item name="strokeColor">@color/vital_dim</item>
    </style>
</resources>
