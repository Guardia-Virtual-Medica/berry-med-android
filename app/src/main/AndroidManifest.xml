<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-feature android:name="android.hardware.usb.host" android:required="false" />

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- El kiosco reintenta la carga apenas Android avisa que volvió la red. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Desde Android 14, connectedDevice pide uno de estos permisos; éste se otorga solo. -->
    <uses-permission android:name="android.permission.CHANGE_NETWORK_STATE" />
    <!--
        El panel lateral muestra el nombre del Wi-Fi y la señal. Sin la ubicación,
        Android 10 en adelante esconde el nombre (<unknown ssid>) y el panel dice
        «Wi-Fi». Desde Android 12 la precisa se pide junto con la aproximada.
    -->
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CONNECTED_DEVICE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <!-- La cámara de la tablet, sólo en el Panel Local. -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera.any" android:required="false" />
    <!-- El estetoscopio del Panel Local, por el adaptador de audio USB. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-feature android:name="android.hardware.microphone" android:required="false" />
    <!-- Fijar el dispositivo de comunicación de la videollamada: hoy llega sólo por la fusión con LiveKit. -->
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    <!--
        La teleconsulta: el servicio publica el otoscopio y el estetoscopio en LiveKit.
        Para eso, además de connectedDevice, va como camera y microphone (ver
        MonitorService); los suma con el kiosco o cualquier pantalla de Berry Med adelante.
    -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CAMERA" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />

    <!--
        El paso Kiosco del configurador pregunta qué app de inicio está elegida.
        Desde Android 11 las otras apps no se ven sin declararlas: sin esto, con
        otro launcher elegido Android contesta Berry Med, la única que ve.
    -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.HOME" />
        </intent>
    </queries>

    <application
        android:name=".BerryMedApp"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:localeConfig="@xml/locales_config"
        tools:targetApi="33"
        android:supportsRtl="true"
        android:theme="@style/Theme.BerryMed"
        android:usesCleartextTraffic="true">

        <!--
            Desde Android 14, al abrir la cámara en una pantalla de orientación fija
            el sistema puede girar la tablet y reiniciar la pantalla ("compatibilidad
            de cámara"). Eso cerraba el Panel Local y volvía a pedir el PIN apenas
            arrancaba la cámara. Son propiedades de la aplicación, no de la pantalla.
        -->
        <property
            android:name="android.window.PROPERTY_CAMERA_COMPAT_ALLOW_FORCE_ROTATION"
            android:value="false" />
        <property
            android:name="android.window.PROPERTY_CAMERA_COMPAT_ALLOW_REFRESH"
            android:value="false" />

        <!--
            Inicio: el distribuidor, con ONDOCTOR365, Panel Local y Configuración.
            Es la app de inicio de la tablet (HOME): Android la abre al encender y
            el botón de inicio vuelve a ella. También la abre el ícono de Berry Med.
        -->
        <activity
            android:name=".ui.HomeActivity"
            android:configChanges="orientation|screenSize|screenLayout|keyboard|keyboardHidden"
            android:exported="true"
            android:launchMode="singleTask"
            android:screenOrientation="landscape"
            android:theme="@style/Theme.BerryMed.Panel"
            android:windowSoftInputMode="adjustPan">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <!-- La configuración y el estado del tótem: se abre desde Inicio, con el PIN. -->
        <activity
            android:name=".ui.MainActivity"
            android:configChanges="orientation|screenSize|screenLayout"
            android:exported="false"
            android:launchMode="singleTask"
            android:theme="@style/Theme.BerryMed.Panel"
            android:windowSoftInputMode="adjustResize" />

        <!--
            El kiosco de OnDoctor dentro de Berry Med, como hacía la app del proveedor:
            un WebView a pantalla completa. Se abre desde Inicio o con su ícono.
            Tiene su propia tarea, como el Panel Local: así el ícono de Berry Med
            muestra Inicio y no el kiosco, y volver a Inicio (singleTask) no
            destruye el kiosco, que sigue cargado para la próxima vez.
        -->
        <activity
            android:name=".ui.KioskActivity"
            android:configChanges="orientation|screenSize|screenLayout|keyboard|keyboardHidden|smallestScreenSize"
            android:excludeFromRecents="false"
            android:exported="true"
            android:launchMode="singleTask"
            android:screenOrientation="landscape"
            android:taskAffinity="com.guardiavirtual.berrymed.kiosk"
            android:theme="@style/Theme.BerryMed.Panel" />

        <!--
            El ícono ONDOCTOR365 de la tablet: abre el kiosco del paciente. Es un
            alias y no otra pantalla porque el kiosco es uno solo, con su WebView,
            su sala de LiveKit y su recarga; tocar el ícono vuelve al mismo.
        -->
        <activity-alias
            android:name=".ui.OnDoctorLauncher"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_ondoctor"
            android:roundIcon="@mipmap/ic_launcher_ondoctor"
            android:label="@string/ondoctor"
            android:targetActivity=".ui.KioskActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity
            android:name=".ui.TestingActivity"
            android:configChanges="orientation|screenSize|screenLayout"
            android:theme="@style/Theme.BerryMed.Panel"
            android:exported="false" />

        <!--
            El Panel Local tiene su propio ícono en la tablet: atención presencial,
            con todos los instrumentos en pantalla y sin Chrome ni envío a la API.
        -->
        <activity
            android:name=".ui.LocalPanelActivity"
            android:configChanges="orientation|screenSize|screenLayout"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_local"
            android:roundIcon="@mipmap/ic_launcher_local"
            android:label="@string/local_panel"
            android:launchMode="singleTask"
            android:screenOrientation="landscape"
            android:taskAffinity="com.guardiavirtual.berrymed.local"
            android:theme="@style/Theme.BerryMed.Panel">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
            Lo que Android abre al conectar un dispositivo del tótem. Sin pantalla y
            en su propia tarea: se cierra enseguida y Chrome queda adelante.
        -->
        <activity
            android:name=".usb.UsbAttachActivity"
            android:excludeFromRecents="true"
            android:exported="true"
            android:noHistory="true"
            android:taskAffinity=""
            android:theme="@android:style/Theme.NoDisplay">
            <intent-filter>
                <action android:name="android.hardware.usb.action.USB_DEVICE_ATTACHED" />
            </intent-filter>
            <meta-data
                android:name="android.hardware.usb.action.USB_DEVICE_ATTACHED"
                android:resource="@xml/usb_device_filter" />
        </activity>

        <!--
            El idioma elegido para la app en Android 12 o menos: AppCompat lo guarda
            y lo repone al abrir. En Android 13 o más lo recuerda el sistema.
        -->
        <service
            android:name="androidx.appcompat.app.AppLocalesMetadataHolderService"
            android:enabled="false"
            android:exported="false">
            <meta-data
                android:name="autoStoreLocales"
                android:value="true" />
        </service>

        <service
            android:name=".service.MonitorService"
            android:exported="false"
            android:foregroundServiceType="connectedDevice|camera|microphone"
            android:stopWithTask="false" />

        <receiver
            android:name=".service.BootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <receiver
            android:name=".usb.UsbAttachReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.hardware.usb.action.USB_DEVICE_ATTACHED" />
                <action android:name="android.hardware.usb.action.USB_DEVICE_DETACHED" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
