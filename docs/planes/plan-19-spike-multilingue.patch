diff --git a/app/src/main/java/com/guardiavirtual/berrymed/i18n/AppLanguage.kt b/app/src/main/java/com/guardiavirtual/berrymed/i18n/AppLanguage.kt
new file mode 100644
index 0000000..cb78a63
--- /dev/null
+++ b/app/src/main/java/com/guardiavirtual/berrymed/i18n/AppLanguage.kt
@@ -0,0 +1,32 @@
+// SPDX-License-Identifier: GPL-3.0-or-later
+package com.guardiavirtual.berrymed.i18n
+
+/**
+ * Los idiomas en los que está la app. [tag] es la etiqueta BCP 47 y el sufijo
+ * de la carpeta de recursos (`values-en`); el español es el idioma de origen y
+ * vive en `values/`. [nativeName] es como se llama el idioma a sí mismo: en el
+ * selector no se traduce, para que lo encuentre quien no lee el idioma actual.
+ *
+ * Sin Android: lo usan el selector, [AppLocale] y los tests.
+ */
+enum class AppLanguage(val tag: String, val nativeName: String) {
+    SPANISH("es", "Español"),
+    ENGLISH("en", "English"),
+    PORTUGUESE("pt", "Português"),
+    ;
+
+    companion object {
+        /** El idioma de origen: el de `values/` y el que queda cuando el de la tablet no está. */
+        val DEFAULT = SPANISH
+
+        /**
+         * El primero de [tags] (una lista como «pt-BR,en-US») que la app tiene,
+         * mirando sólo el idioma y no la región; null si no hay ninguno.
+         */
+        fun match(tags: String?): AppLanguage? =
+            tags.orEmpty().split(',').firstNotNullOfOrNull { tag ->
+                val language = tag.trim().substringBefore('-').substringBefore('_').lowercase()
+                entries.firstOrNull { it.tag == language }
+            }
+    }
+}
diff --git a/app/src/main/java/com/guardiavirtual/berrymed/i18n/AppLocale.kt b/app/src/main/java/com/guardiavirtual/berrymed/i18n/AppLocale.kt
new file mode 100644
index 0000000..522c909
--- /dev/null
+++ b/app/src/main/java/com/guardiavirtual/berrymed/i18n/AppLocale.kt
@@ -0,0 +1,45 @@
+// SPDX-License-Identifier: GPL-3.0-or-later
+package com.guardiavirtual.berrymed.i18n
+
+import android.content.Context
+import android.content.res.Configuration
+import android.os.LocaleList
+import androidx.appcompat.app.AppCompatDelegate
+import androidx.core.os.LocaleListCompat
+import java.util.Locale
+
+/**
+ * El idioma elegido para Berry Med, aparte del de la tablet.
+ *
+ * Lo guarda y lo aplica AppCompat (`setApplicationLocales`): en Android 13 o
+ * más se lo pasa al sistema, que lo recuerda y lo aplica a todo el proceso
+ * (pantallas, servicio y contexto de la aplicación); en los anteriores lo
+ * guarda AppCompat (`autoStoreLocales` en el manifest) y lo aplica sólo a las
+ * pantallas, por eso lo que no es pantalla pasa por [localized].
+ */
+object AppLocale {
+    /** El idioma en uso: el elegido o, sin elegir, el de la tablet si la app lo tiene. */
+    fun current(): AppLanguage =
+        AppLanguage.match(AppCompatDelegate.getApplicationLocales().toLanguageTags())
+            ?: AppLanguage.match(LocaleList.getDefault().toLanguageTags())
+            ?: AppLanguage.DEFAULT
+
+    /** Cambia el idioma: Android recrea las pantallas abiertas con los textos nuevos. */
+    fun set(language: AppLanguage) {
+        AppCompatDelegate.setApplicationLocales(LocaleListCompat.forLanguageTags(language.tag))
+    }
+
+    /**
+     * [context] con el idioma en uso, para lo que no es una pantalla (el
+     * servicio, la notificación, el runtime). En Android 13 o más devuelve
+     * textos iguales a los del contexto: el sistema ya lo aplicó.
+     */
+    fun localized(context: Context): Context = withLanguage(context, current())
+
+    /** [context] en un idioma fijo, sin importar el elegido: los logs van siempre en español. */
+    fun withLanguage(context: Context, language: AppLanguage): Context {
+        val config = Configuration(context.resources.configuration)
+        config.setLocale(Locale.forLanguageTag(language.tag))
+        return context.createConfigurationContext(config)
+    }
+}
diff --git a/app/src/main/java/com/guardiavirtual/berrymed/i18n/Txt.kt b/app/src/main/java/com/guardiavirtual/berrymed/i18n/Txt.kt
