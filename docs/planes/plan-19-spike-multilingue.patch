+// SPDX-License-Identifier: GPL-3.0-or-later
+package com.guardiavirtual.berrymed.i18n
+
+import java.io.File
+import kotlin.test.Test
+import kotlin.test.assertEquals
+import kotlin.test.assertNull
+
+class AppLanguageTest {
+    @Test
+    fun matchesByLanguageNotRegion() {
+        assertEquals(AppLanguage.PORTUGUESE, AppLanguage.match("pt-BR"))
+        assertEquals(AppLanguage.ENGLISH, AppLanguage.match("en-US,es-AR"))
+        assertEquals(AppLanguage.SPANISH, AppLanguage.match("es_AR"))
+        // El primero que la app tiene, en el orden de la tablet.
+        assertEquals(AppLanguage.SPANISH, AppLanguage.match("fr-FR,es-419,en-US"))
+        assertNull(AppLanguage.match("fr-FR,de"))
+        assertNull(AppLanguage.match(""))
+        assertNull(AppLanguage.match(null))
+    }
+
+    /** El selector, las carpetas de recursos y lo que se le declara a Android dicen lo mismo. */
+    @Test
+    fun theSelectorTheFoldersAndTheManifestAgree() {
+        val selector = AppLanguage.entries.map { it.tag }.sorted()
+
+        val folders = (TestStrings.translations() + AppLanguage.DEFAULT.tag).sorted()
+        assertEquals(selector, folders, "AppLanguage y las carpetas values-xx")
+
+        val declared = Regex("""<locale\s+android:name="([^"]+)"""")
+            .findAll(File(TestStrings.resDir, "xml/locales_config.xml").readText())
+            .map { it.groupValues[1] }
+            .toList()
+            .sorted()
+        assertEquals(selector, declared, "AppLanguage y res/xml/locales_config.xml")
+
+        val gradle = File("build.gradle.kts").readText()
+        val bundled = Regex("""resourceConfigurations \+= listOf\(([^)]*)\)""").find(gradle)
+            ?.groupValues?.get(1)?.split(',')?.map { it.trim().trim('"') }?.sorted()
+        assertEquals(selector, bundled, "AppLanguage y resourceConfigurations de build.gradle.kts")
+    }
+
+    @Test
+    fun nativeNamesAreNotTranslated() {
+        // Cada idioma se llama igual en todos los diccionarios: no hay entradas language_es / language_en.
+        assertEquals(listOf("Español", "English", "Português"), AppLanguage.entries.map { it.nativeName })
+    }
+}
diff --git a/app/src/test/java/com/guardiavirtual/berrymed/i18n/HardcodedTextTest.kt b/app/src/test/java/com/guardiavirtual/berrymed/i18n/HardcodedTextTest.kt
new file mode 100644
index 0000000..2a22d24
--- /dev/null
+++ b/app/src/test/java/com/guardiavirtual/berrymed/i18n/HardcodedTextTest.kt
@@ -0,0 +1,206 @@
+// SPDX-License-Identifier: GPL-3.0-or-later
+package com.guardiavirtual.berrymed.i18n
+
+import java.io.File
+import kotlin.test.Test
+import kotlin.test.assertEquals
+
+/**
+ * Que no vuelva a entrar un texto escrito en el código.
+ *
+ * Lee los fuentes de `src/main` y junta todo literal que parece una frase
+ * para una persona. Cada uno tiene que estar en `src/test/resources/i18n/textos-en-codigo.txt`,
+ * en una de dos listas:
+ *
+ * - **PENDIENTE**: falta pasarlo al diccionario. La migración la lleva a cero.
+ * - **PERMITIDO**: se queda en el código a propósito (motivos de los logs,
+ *   nombres de protocolo), revisado uno por uno.
+ *
+ * Las líneas de log, que empiezan con su etiqueta (`[USB] …`), no cuentan: el
+ * log va siempre en español. Un texto nuevo que no está en ninguna lista falla
+ * el test; uno que ya se sacó del código y sigue anotado, también: la lista
+ * sólo se achica.
+ */
+class HardcodedTextTest {
+    private val sources = File("src/main/java")
+    private val layouts = File("src/main/res/layout")
+    private val listFile = File("src/test/resources/i18n/textos-en-codigo.txt")
+
+    /** Un literal de Kotlin: dónde está y qué dice, con `${…}` reducido a «{}». */
+    data class Found(val file: String, val text: String) {
+        override fun toString() = "$file\t$text"
+    }
+
+    @Test
+    fun noNewHardcodedTextInKotlin() {
+        val found = kotlinFiles().flatMap { file -> literals(file.readText()).filter(::looksLikeProse).map { Found(relative(file), it) } }.toSet()
+        if (System.getenv("I18N_REGENERAR") == "1") {
+            regenerate(found)
+            return
+        }
+        val (pending, allowed) = readLists()
+        val known = pending + allowed
+        val now = found.map { it.toString() }.toSet()
+        assertEquals(emptyList(), (now - known).sorted(), "Textos nuevos escritos en el código: van al diccionario (strings.xml)")
+        assertEquals(emptyList(), (known - now).sorted(), "Ya no están en el código: sacalos de textos-en-codigo.txt")
+    }
+
+    /** En los layouts no hay listas: un texto con letras va a `@string/…` (o a `tools:text` si es de muestra). */
+    @Test
+    fun layoutsHaveNoHardcodedText() {
+        val attribute = Regex("""android:(text|hint|contentDescription|title|label|tooltipText)="([^"@?][^"]*)"""")
+        val found = layouts.listFiles { file -> file.extension == "xml" }.orEmpty().sortedBy { it.name }.flatMap { file ->
+            attribute.findAll(file.readText())
+                .map { it.groupValues[2] }
+                // Un número solo no se traduce, pero con coma o punto decimal sí cambia con el idioma.
+                .filter { value -> value.any { it.isLetter() } || Regex("""\d[.,]\d""").containsMatchIn(value) }
+                .map { "${file.name}\t$it" }
+                .toList()
+        }
+        val allowed = readSection("LAYOUTS")
+        assertEquals(emptyList(), (found.toSet() - allowed).sorted(), "Textos escritos en un layout")
+        assertEquals(emptyList(), (allowed - found.toSet()).sorted(), "Ya no están en los layouts: sacalos de textos-en-codigo.txt")
+    }
+
+    private fun kotlinFiles(): List<File> = sources.walkTopDown().filter { it.isFile && it.extension == "kt" }.sortedBy { it.path }.toList()
+
+    private fun relative(file: File): String = file.relativeTo(sources).path.substringAfter("com/guardiavirtual/berrymed/")
+
+    private fun readSection(section: String): Set<String> {
+        if (!listFile.exists()) return emptySet()
+        val lines = HashSet<String>()
+        var current = ""
+        for (line in listFile.readLines()) {
+            when {
+                line.startsWith("## ") -> current = line.removePrefix("## ").trim()
+                line.isBlank() || line.startsWith("#") -> Unit
+                current == section -> lines += line
+            }
+        }
+        return lines
+    }
+
+    private fun readLists(): Pair<Set<String>, Set<String>> = Pair(readSection("PENDIENTE"), readSection("PERMITIDO"))
+
+    /** Todo lo encontrado va a PENDIENTE, salvo lo que ya estaba en PERMITIDO; los layouts, a su lista. */
+    private fun regenerate(found: Set<Found>) {
+        val allowed = readSection("PERMITIDO")
+        val now = found.map { it.toString() }.toSet()
+        val attribute = Regex("""android:(text|hint|contentDescription|title|label|tooltipText)="([^"@?][^"]*)"""")
+        val inLayouts = layouts.listFiles { file -> file.extension == "xml" }.orEmpty().sortedBy { it.name }.flatMap { file ->
+            attribute.findAll(file.readText()).map { it.groupValues[2] }
+                .filter { value -> value.any { it.isLetter() } || Regex("""\d[.,]\d""").containsMatchIn(value) }
+                .map { "${file.name}\t$it" }.toList()
+        }.toSortedSet()
+        listFile.parentFile.mkdirs()
+        listFile.writeText(
+            buildString {
+                appendLine("# Textos escritos en el código (ver HardcodedTextTest). Una línea: archivo<TAB>texto.")
+                appendLine("# Regenerar: I18N_REGENERAR=1 ./gradlew testDebugUnitTest --tests '*HardcodedTextTest*'")
+                appendLine()
+                appendLine("## PENDIENTE")
+                (now - allowed).sorted().forEach(::appendLine)
+                appendLine()
+                appendLine("## PERMITIDO")
+                (allowed intersect now).sorted().forEach(::appendLine)
+                appendLine()
+                appendLine("## LAYOUTS")
+                inLayouts.forEach(::appendLine)
+            },
+        )
+    }
+
+    companion object {
+        private val logTag = Regex("""^\[[A-ZÁÉÍÓÚÑ0-9 ]+]""")
+        private val word = Regex("""\p{L}{3,}""")
+        private val twoWords = Regex("""\p{L}{2,}\s+\p{L}{2,}""")
+        private val capitalized = Regex("""^[A-ZÁÉÍÓÚÑ][a-záéíóúñ]{3,}…?$""")
+
+        /**
+         * ¿Es una frase para una persona? Tiene una palabra y, además, dos
+         * palabras seguidas, una letra que no es ASCII (á, ñ, «, …) o es una
+         * sola palabra con mayúscula inicial («Conectado»). Quedan afuera los
+         * identificadores («berry-usb», «start-monitoring», «HH:mm») y las
+         * líneas de log por su etiqueta.
+         */
+        fun looksLikeProse(literal: String): Boolean {
+            if (logTag.containsMatchIn(literal)) return false
+            val text = literal.replace("{}", " ").trim()
+            if (!word.containsMatchIn(text)) return false
+            return twoWords.containsMatchIn(text) || text.any { it.isLetter() && it.code > 127 } || text.any { it in "«»…·¿¡" } ||
+                capitalized.matches(text)
+        }
+
+        /** Los literales de un fuente Kotlin, sin los comentarios; cada `${…}` o `$nombre` queda como «{}». */
+        fun literals(source: String): List<String> {
+            val out = ArrayList<String>()
+            var i = 0
+            val n = source.length
+            while (i < n) {
+                val c = source[i]
+                when {
+                    source.startsWith("//", i) -> i = source.indexOf('\n', i).let { if (it < 0) n else it }
+                    source.startsWith("/*", i) -> i = source.indexOf("*/", i).let { if (it < 0) n else it + 2 }
+                    source.startsWith("\"\"\"", i) -> {
+                        var end = source.indexOf("\"\"\"", i + 3).let { if (it < 0) n else it }
+                        // Un literal crudo termina en las últimas tres comillas: `"""…""""` trae una adentro.
+                        while (end + 3 < n && source[end + 3] == '"') end++
+                        out += source.substring(i + 3, end).replace('\n', ' ')
+                        i = end + 3
+                    }
+                    c == '\'' -> {
+                        var j = i + 1
+                        while (j < n && source[j] != '\'') j += if (source[j] == '\\') 2 else 1
+                        i = j + 1
+                    }
+                    c == '"' -> {
+                        val text = StringBuilder()
+                        var j = i + 1
+                        while (j < n && source[j] != '"') {
+                            when {
+                                source[j] == '\\' -> {
+                                    text.append(source, j, minOf(j + 2, n))
+                                    j += 2
+                                }
+                                source.startsWith("\${", j) -> {
+                                    // Una plantilla puede traer literales adentro: se leen aparte.
+                                    var depth = 1
+                                    var k = j + 2
+                                    while (k < n && depth > 0) {
+                                        when (source[k]) {
+                                            '{' -> depth++
+                                            '}' -> depth--
+                                            '"' -> {
+                                                var m = k + 1
+                                                while (m < n && source[m] != '"') m += if (source[m] == '\\') 2 else 1
+                                                k = m
+                                            }
+                                        }
+                                        k++
+                                    }
+                                    out += literals(source.substring(j + 2, k - 1))
+                                    text.append("{}")
+                                    j = k
+                                }
+                                source[j] == '$' && j + 1 < n && (source[j + 1].isLetter() || source[j + 1] == '_') -> {
+                                    var k = j + 1
+                                    while (k < n && (source[k].isLetterOrDigit() || source[k] == '_')) k++
+                                    text.append("{}")
+                                    j = k
+                                }
+                                else -> {
+                                    text.append(source[j])
+                                    j++
+                                }
+                            }
+                        }
+                        out += text.toString()
+                        i = j + 1
+                    }
+                    else -> i++
+                }
+            }
+            return out
+        }
+    }
+}
diff --git a/app/src/test/java/com/guardiavirtual/berrymed/i18n/StringsCatalogTest.kt b/app/src/test/java/com/guardiavirtual/berrymed/i18n/StringsCatalogTest.kt
new file mode 100644
index 0000000..a30a05d
--- /dev/null
+++ b/app/src/test/java/com/guardiavirtual/berrymed/i18n/StringsCatalogTest.kt
@@ -0,0 +1,100 @@
+// SPDX-License-Identifier: GPL-3.0-or-later
+package com.guardiavirtual.berrymed.i18n
+
+import java.io.File
+import kotlin.test.Test
+import kotlin.test.assertEquals
+import kotlin.test.assertTrue
+
+/**
+ * Los diccionarios entre sí: cada traducción tiene las mismas entradas que el
+ * español, con los mismos parámetros, y nada de más.
+ *
+ * Mientras dura la migración, lo que todavía no se tradujo está anotado en
+ * `src/test/resources/i18n/sin-traducir.txt` (una línea «idioma<TAB>entrada»).
+ * La lista sólo puede achicarse: una entrada nueva sin traducir falla, y una
+ * que ya se tradujo y sigue anotada también. Con la lista vacía, es paridad total.
+ */
+class StringsCatalogTest {
+    private val source = TestStrings.catalog()
+    private val pendingFile = File("src/test/resources/i18n/sin-traducir.txt")
+
+    private fun pending(): Set<String> =
+        if (!pendingFile.exists()) emptySet()
+        else pendingFile.readLines().map { it.trim() }.filter { it.isNotEmpty() && !it.startsWith("#") }.toSet()
+
+    private fun missingNow(): Set<String> = TestStrings.translations().flatMap { language ->
+        val translated = TestStrings.catalog(language).keys
+        source.values.filter { it.translatable && it.name !in translated }.map { "$language\t${it.name}" }
+    }.toSet()
+
+    @Test
+    fun everyEntryIsTranslatedOrListedAsPending() {
+        val missing = missingNow()
+        if (System.getenv("I18N_REGENERAR") == "1") {
+            pendingFile.parentFile.mkdirs()
+            pendingFile.writeText(
+                "# Entradas de values/strings.xml que todavía no están en cada traducción.\n" +
+                    "# Sólo se achica. Regenerar: I18N_REGENERAR=1 ./gradlew testDebugUnitTest --tests '*StringsCatalogTest*'\n" +
+                    missing.sorted().joinToString("\n", postfix = "\n"),
+            )
+            return
+        }
+        val listed = pending()
+        assertEquals(emptyList(), (missing - listed).sorted(), "Entradas nuevas sin traducir (traducilas o, si es a propósito, anotalas)")
+        assertEquals(emptyList(), (listed - missing).sorted(), "Ya están traducidas: sacalas de sin-traducir.txt")
+    }
+
+    @Test
+    fun translationsHaveNoEntriesOfTheirOwn() {
+        for (language in TestStrings.translations()) {
+            val extra = TestStrings.catalog(language).keys - source.keys
+            assertEquals(emptySet(), extra, "values-$language tiene entradas que el español no tiene")
+        }
+    }
+
+    @Test
+    fun whatIsNotTranslatableIsNotTranslated() {
+        val fixed = source.values.filterNot { it.translatable }.map { it.name }.toSet()
+        for (language in TestStrings.translations()) {
+            assertEquals(emptySet(), TestStrings.catalog(language).keys intersect fixed, "values-$language traduce algo marcado translatable=false")
+        }
+    }
+
+    /** `%1$s`, `%2$d`…: los mismos en todos los idiomas, aunque cambien de orden. */
+    @Test
+    fun translationsKeepTheParameters() {
+        for (language in TestStrings.translations()) {
+            for ((name, entry) in TestStrings.catalog(language)) {
+                val original = source[name] ?: continue
+                assertEquals(parameters(original.value), parameters(entry.value), "Parámetros de $name en values-$language")
+            }
+        }
+    }
+
+    /** Con más de un parámetro van numerados (`%1$s`): sin número, un idioma no puede cambiarles el orden. */
+    @Test
+    fun parametersArePositional() {
+        val all = listOf("") + TestStrings.translations()
+        for (language in all) {
+            for ((name, entry) in TestStrings.catalog(language)) {
+                val loose = Regex("""%(?!\d+\$)[sdf.\d]""").findAll(entry.value.replace("%%", "")).count()
+                assertEquals(0, loose, "$name (${language.ifEmpty { "es" }}) usa un parámetro sin número: ${entry.value}")
+            }
+        }
+    }
+
+    @Test
+    fun nothingIsEmpty() {
+        for (language in listOf("") + TestStrings.translations()) {
+            val empty = TestStrings.catalog(language).values.filter { it.value.isBlank() }.map { it.name }
+            assertTrue(empty.isEmpty(), "Entradas vacías en ${language.ifEmpty { "es" }}: $empty")
+        }
+    }
+
+    private fun parameters(value: String): List<String> =
+        Regex("""%(\d+)\$[-#+ 0,(]*\d*(?:\.\d+)?([a-zA-Z])""").findAll(value.replace("%%", ""))
+            .map { "${it.groupValues[1]}${it.groupValues[2]}" }
+            .sorted()
+            .toList()
+}
diff --git a/app/src/test/java/com/guardiavirtual/berrymed/i18n/TestStrings.kt b/app/src/test/java/com/guardiavirtual/berrymed/i18n/TestStrings.kt
new file mode 100644
index 0000000..e18b706
--- /dev/null
+++ b/app/src/test/java/com/guardiavirtual/berrymed/i18n/TestStrings.kt
@@ -0,0 +1,70 @@
+// SPDX-License-Identifier: GPL-3.0-or-later
+package com.guardiavirtual.berrymed.i18n
+
+import com.guardiavirtual.berrymed.R
+import java.io.File
+import javax.xml.parsers.DocumentBuilderFactory
+import org.w3c.dom.Element
+
+/**
+ * Los diccionarios de la app leídos del disco, para los tests de la JVM (sin
+ * Android ni Robolectric): `res/values/strings.xml` es el español de origen y
+ * `res/values-xx/strings.xml`, cada traducción.
+ *
+ * Gradle corre los tests con el módulo `app` como carpeta de trabajo.
+ */
+object TestStrings {
+    val resDir = File("src/main/res")
+
+    /** Una entrada del diccionario tal como está escrita en el XML. */
+    data class Entry(val name: String, val value: String, val translatable: Boolean)
+
+    private val cache = HashMap<String, Map<String, Entry>>()
+
+    /** id de `R.string` → nombre de la entrada. */
+    private val names: Map<Int, String> by lazy {
+        R.string::class.java.fields.associate { it.getInt(null) to it.name }
+    }
+
+    /** Las carpetas de traducción que existen: «en», «pt»… (sin la de origen). */
+    fun translations(): List<String> =
+        resDir.listFiles { file -> file.isDirectory && file.name.startsWith("values-") && File(file, "strings.xml").exists() }
+            .orEmpty()
+            .map { it.name.removePrefix("values-") }
+            .sorted()
+
+    /** El diccionario de [language]; "" es el de origen. */
+    fun catalog(language: String = ""): Map<String, Entry> = cache.getOrPut(language) {
+        val file = File(resDir, if (language.isEmpty()) "values/strings.xml" else "values-$language/strings.xml")
+        val root = DocumentBuilderFactory.newInstance().newDocumentBuilder().parse(file).documentElement
+        val entries = LinkedHashMap<String, Entry>()
+        val nodes = root.getElementsByTagName("string")
+        for (i in 0 until nodes.length) {
+            val node = nodes.item(i) as Element
+            val name = node.getAttribute("name")
+            entries[name] = Entry(name, unescape(node.textContent), node.getAttribute("translatable") != "false")
+        }
+        entries
+    }
+
+    /** Lo que Android hace al leer el XML: saca las barras de escape. */
+    private fun unescape(raw: String): String =
+        raw.trim().replace("\\'", "'").replace("\\\"", "\"").replace("\\n", "\n").replace("\\@", "@").replace("\\?", "?")
+
+    /** [text] como lo vería alguien en [language]; lo que falta traducir cae al español, como en Android. */
+    fun resolve(text: Txt, language: String = ""): String = when (text) {
+        is Txt.Raw -> text.value
+        is Txt.Res -> {
+            val name = names[text.id] ?: error("No hay R.string con id ${text.id}")
+            val pattern = (catalog(language)[name] ?: catalog()[name] ?: error("Falta $name en values/strings.xml")).value
+            val args = text.args.map { if (it is Txt) resolve(it, language) else it }
+            if (args.isEmpty()) pattern else String.format(pattern, *args.toTypedArray())
+        }
+    }
+}
+
+/** El texto en español, el idioma de origen: para los tests que afirman lo que se lee en pantalla. */
+fun es(text: Txt): String = TestStrings.resolve(text)
+
+/** El texto en [language] («en», «pt»). */
+fun Txt.inLanguage(language: String): String = TestStrings.resolve(this, language)
